{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "incremental": true,
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/__fixtures__/**",
    "node_modules",
    "dist"
  ],
  "references": [
    { "path": "../core/tsconfig.build.json" },
    { "path": "../cli-contract/tsconfig.build.json" },
    { "path": "../extract/tsconfig.build.json" }
  ]
}
