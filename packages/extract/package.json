{
  "name": "@earsyntax/extract",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Suites",
  "description": "Extract EARS requirements from .ears, Markdown, YAML, and JSON files.",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "predev": "pnpm rimraf dist tsconfig.build.tsbuildinfo",
    "build": "pnpm tsc -p tsconfig.build.json",
    "dev": "pnpm tsc -p tsconfig.build.json --watch --incremental",
    "lint": "pnpm eslint \"src/**/*.ts\"",
    "lint:fix": "pnpm eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@earsyntax/core": "workspace:*",
    "js-yaml": "catalog:"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  }
}
